# Секреты — НИКОГДА не попадают в репозиторий.
secrets.local.json
*.local.json
.env

# Локальные данные и состояние
data_cache/
*.db

# Служебное
__pycache__/
*.pyc
.venv/
venv/

# cache/ НЕ игнорируется намеренно. Кеш свечей и сигналов — основа всех
# замеров, и пересобирать его должна автоматика раз в месяц. На GitHub
# каждый проход начинается с чистой выгрузки: то, что не в репозитории,
# пропадает. Игнорируя кеш, мы бы гоняли пересбор впустую.
# Цена: около 6 МБ в месяц истории. Приемлемо; если разрастётся —
# историю кеша можно будет подрезать отдельно.

# Результаты прогонов — пересоздаются запуском, в репозитории не нужны
